
/*
  MCSH SCRIPT L
  Remember the lookahead operator: /
*/

%option prefix="mcsh_script_"
%option noyywrap

%{
  #include <stdbool.h>
  #include <stdio.h>
  // #include "util.h"  // For show()
  #include "mcsh-script-parser.h"
  // Generated by bison:
  #include "mcsh-script-grammar.h"
%}

STRINGLITERAL ["](([\\]["])|([^"]))*["]

   bool mcsh_script_token_quoted;
   int mcsh_script_line = 1;

%%

{STRINGLITERAL} {
  mcsh_log(mcsh.parse_state.logger, MCSH_LOG_PARSE, MCSH_INFO,
           "lexer: STRINGLITERAL: '%s'", mcsh_script_text);
  mcsh_script_token_quoted = true;
  mcsh_script_lval.sval = strdup(mcsh_script_text);
  return STRING;
}

[ \t]+/"))" { /* consumes whitespace at end of stmt before )) */ }

[ \t]+ {
  printf("WS\n");
  return WS; }


\n  { printf("NL\n"); mcsh_script_line++; return NL; }
";" { return SEMICOLON; }

"{"  { return LBRACE; }
"}"  { return RBRACE; }

"))"  { return RPARENS; }

"(("  { return FUNCTN; }

"=" { return EQ; }

[\[\]_:.,$#@!?+\-~*/%<>a-zA-Z0-9()]+      {
  mcsh_log(mcsh.parse_state.logger, MCSH_LOG_PARSE, MCSH_INFO,
           "lexer: STRING: '%s'", mcsh_script_text);
  mcsh_script_token_quoted = false;
  mcsh_script_lval.sval = strdup(mcsh_script_text);
  return STRING;
}

<<EOF>> { return END; }

%%
// "$((" { return SUBCMD; }


void
mcsh_script_source_set(char* text)
{
  yy_scan_string(text);
}

void
mcsh_script_clean(void)
{
  mcsh_node_free(mcsh.parse_state.output, 0);
}
